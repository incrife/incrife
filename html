        .footer-links a {
            font-family: var(--font-serif);
            font-size: 14px;
            color: var(--gray);
            text-decoration: none;
            transition: all 0.3s;
            font-weight: 300;
        }

        .footer-links a:hover {
            color: var(--light);
            padding-left: 5px;
