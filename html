<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JAVIER MOLES | Artista Techno Barcelona</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <span class="logo-text">JM</span>
                <span class="logo-sub">TECHNO</span>
            </div>
            <ul class="nav-menu">
                <li><a href="#home" class="nav-link active">INICIO</a></li>
                <li><a href="#music" class="nav-link">MÚSICA</a></li>
                <li><a href="#videos" class="nav-link">VIDEOS</a></li>
                <li><a href="#shows" class="nav-link">SHOWS</a></li>
                <li><a href="#contact" class="nav-link">CONTACTO</a></li>
            </ul>
            <div class="social-header">
                <a href="#" class="social-icon"><i class="fab fa-soundcloud"></i></a>
                <a href="#" class="social-icon"><i class="fab fa-spotify"></i></a>
                <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
            </div>
            <div class="menu-toggle">
                <i class="fas fa-bars"></i>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">JAVIER <span class="accent">MOLES</span></h1>
                <p class="hero-subtitle">ARTISTA TECHNO · PRODUCTOR · BARCELONA</p>
                <p class="hero-description">Sonidos industriales mezclados con la estética futurista. Experiencias sonoras inmersivas.</p>
                <div class="hero-buttons">
                    <a href="#music" class="btn-primary">ESCUCHAR MÚSICA</a>
                    <a href="#shows" class="btn-secondary">PRÓXIMOS SHOWS</a>
                </div>
            </div>
            <div class="hero-image">
                <div class="image-placeholder">
                    <div class="circle"></div>
                    <div class="circle"></div>
                    <div class="circle"></div>
                </div>
            </div>
        </div>
        <div class="scroll-indicator">
            <i class="fas fa-chevron-down"></i>
        </div>
    </section>

    <!-- Music Section -->
    <section id="music" class="section music-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">ÚLTIMOS <span class="accent">LANZAMIENTOS</span></h2>
                <p class="section-subtitle">Explora mi catálogo de techno experimental</p>
            </div>
            
            <div class="music-grid">
                <!-- Track 1 -->
                <div class="track-card">
                    <div class="track-cover">
                        <div class="cover-image" style="background: linear-gradient(135deg, #333 0%, #666 100%);">
                            <span class="track-number">01</span>
                        </div>
                        <button class="play-btn">
                            <i class="fas fa-play"></i>
                        </button>
                    </div>
                    <div class="track-info">
                        <h3 class="track-title">NEON DREAMS</h3>
                        <p class="track-meta">EP · 2024 · 6 tracks</p>
                        <div class="track-stats">
                            <span><i class="fas fa-play-circle"></i> 45.2K</span>
                            <span><i class="fas fa-heart"></i> 2.1K</span>
                        </div>
                        <div class="platform-links">
                            <a href="#" class="platform-btn spotify">
                                <i class="fab fa-spotify"></i> Spotify
                            </a>
                            <a href="#" class="platform-btn soundcloud">
                                <i class="fab fa-soundcloud"></i> SoundCloud
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Track 2 -->
                <div class="track-card">
                    <div class="track-cover">
                        <div class="cover-image" style="background: linear-gradient(135deg, #555 0%, #888 100%);">
                            <span class="track-number">02</span>
                        </div>
                        <button class="play-btn">
                            <i class="fas fa-play"></i>
                        </button>
                    </div>
                    <div class="track-info">
                        <h3 class="track-title">SYNTHETIC RAIN</h3>
                        <p class="track-meta">Single · 2023 · Industrial Techno</p>
                        <div class="track-stats">
                            <span><i class="fas fa-play-circle"></i> 28.7K</span>
                            <span><i class="fas fa-heart"></i> 1.5K</span>
                        </div>
                        <div class="platform-links">
                            <a href="#" class="platform-btn spotify">
                                <i class="fab fa-spotify"></i> Spotify
                            </a>
                            <a href="#" class="platform-btn soundcloud">
                                <i class="fab fa-soundcloud"></i> SoundCloud
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Track 3 -->
                <div class="track-card">
                    <div class="track-cover">
                        <div class="cover-image" style="background: linear-gradient(135deg, #777 0%, #aaa 100%);">
                            <span class="track-number">03</span>
                        </div>
                        <button class="play-btn">
                            <i class="fas fa-play"></i>
                        </button>
                    </div>
                    <div class="track-info">
                        <h3 class="track-title">BAIXA ANOMALY</h3>
                        <p class="track-meta">Live Set · Barcelona · 2023</p>
                        <div class="track-stats">
                            <span><i class="fas fa-play-circle"></i> 62.4K</span>
                            <span><i class="fas fa-heart"></i> 3.8K</span>
                        </div>
                        <div class="platform-links">
                            <a href="#" class="platform-btn spotify">
                                <i class="fab fa-spotify"></i> Spotify
                            </a>
                            <a href="#" class="platform-btn soundcloud">
                                <i class="fab fa-soundcloud"></i> SoundCloud
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Videos Section -->
    <section id="videos" class="section video-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">SHORT FILMS & <span class="accent">VISUALES</span></h2>
                <p class="section-subtitle">Experiencias audiovisuales inmersivas</p>
            </div>
            
            <div class="video-grid">
                <!-- Main Video -->
                <div class="video-main">
                    <div class="video-player">
                        <div class="video-placeholder">
                            <div class="play-overlay">
                                <i class="fas fa-play-circle"></i>
                                <span>VER SHORT FILM</span>
                            </div>
                        </div>
                        <div class="video-info">
                            <h3 class="video-title">"RESONANCIA ANALÓGICA"</h3>
                            <p class="video-desc">Un viaje cinematográfico por Barcelona industrial. Filmado en 16mm con postproducción digital. 12 min.</p>
                            <div class="video-meta">
                                <span><i class="fas fa-calendar"></i> Estreno: Oct 2023</span>
                                <span><i class="fas fa-eye"></i> 124.5K vistas</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Video Thumbnails -->
                <div class="video-thumbnails">
                    <div class="thumbnail">
                        <div class="thumb-image"></div>
                        <div class="thumb-info">
                            <h4>LIVE @ SONAR 2023</h4>
                            <p>Set completo · 45 min</p>
                        </div>
                    </div>
                    <div class="thumbnail">
                        <div class="thumb-image"></div>
                        <div class="thumb-info">
                            <h4>MAKING OF: NEON DREAMS</h4>
                            <p>Documental estudio · 22 min</p>
                        </div>
                    </div>
                    <div class="thumbnail">
                        <div class="thumb-image"></div>
                        <div class="thumb-info">
                            <h4>VISUAL SET 2024</h4>
                            <p>A/V Performance · 38 min</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Shows Section -->
    <section id="shows" class="section shows-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">PRÓXIMOS <span class="accent">SHOWS</span></h2>
                <p class="section-subtitle">Eventos y presentaciones en vivo</p>
            </div>
            
            <div class="shows-timeline">
                <!-- Show 1 -->
                <div class="show-card">
                    <div class="show-date">
                        <span class="date-day">15</span>
                        <span class="date-month">OCT</span>
                    </div>
                    <div class="show-info">
                        <h3 class="show-title">RAZZMATAZZ · BARCELONA</h3>
                        <p class="show-location"><i class="fas fa-map-marker-alt"></i> Sala 2, Barcelona</p>
                        <p class="show-desc">Noche de techno industrial con visual mapping en vivo.</p>
                    </div>
                    <div class="show-actions">
                        <a href="#" class="btn-ticket">COMPRAR ENTRADA</a>
                        <span class="show-status">AGOTÁNDOSE</span>
                    </div>
                </div>

                <!-- Show 2 -->
                <div class="show-card">
                    <div class="show-date">
                        <span class="date-day">22</span>
                        <span class="date-month">OCT</span>
                    </div>
                    <div class="show-info">
                        <h3 class="show-title">INPUT HIGH FIDELITY</h3>
                        <p class="show-location"><i class="fas fa-map-marker-alt"></i> Barcelona</p>
                        <p class="show-desc">Set especial 4 horas para el 10º aniversario.</p>
                    </div>
                    <div class="show-actions">
                        <a href="#" class="btn-ticket">COMPRAR ENTRADA</a>
                        <span class="show-status available">DISPONIBLE</span>
                    </div>
                </div>

                <!-- Show 3 -->
                <div class="show-card">
                    <div class="show-date">
                        <span class="date-day">05</span>
                        <span class="date-month">NOV</span>
                    </div>
                    <div class="show-info">
                        <h3 class="show-title">SONAR BY NIGHT</h3>
                        <p class="show-location"><i class="fas fa-map-marker-alt"></i> Fira Barcelona</p>
                        <p class="show-desc">Presentación del nuevo A/V show "Neon Dreams".</p>
                    </div>
                    <div class="show-actions">
                        <a href="#" class="btn-ticket">COMPRAR ENTRADA</a>
                        <span class="show-status">PRÓXIMAMENTE</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Social & Contact -->
    <section id="contact" class="section contact-section">
        <div class="container">
            <div class="contact-grid">
                <!-- Social Media -->
                <div class="social-section">
                    <h2 class="section-title">CONECTA <span class="accent">CONMIGO</span></h2>
                    <p class="section-subtitle">Sígueme en redes para updates y contenido exclusivo</p>
                    
                    <div class="social-links-grid">
                        <a href="#" class="social-link instagram">
                            <i class="fab fa-instagram"></i>
                            <div>
                                <h4>Instagram</h4>
                                <p>@javiermoles.techno</p>
                            </div>
                        </a>
                        <a href="#" class="social-link spotify">
                            <i class="fab fa-spotify"></i>
                            <div>
                                <h4>Spotify</h4>
                                <p>Javier Moles · 45K mensuales</p>
                            </div>
                        </a>
                        <a href="#" class="social-link soundcloud">
                            <i class="fab fa-soundcloud"></i>
                            <div>
                                <h4>SoundCloud</h4>
                                <p>Sets en vivo y exclusivos</p>
                            </div>
                        </a>
                        <a href="#" class="social-link youtube">
                            <i class="fab fa-youtube"></i>
                            <div>
                                <h4>YouTube</h4>
                                <p>A/V performances</p>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="form-section">
                    <h2 class="section-title">CONTACTO <span class="accent">BOOKING</span></h2>
                    <p class="section-subtitle">Para contrataciones y colaboraciones</p>
                    
                    <form class="contact-form">
                        <div class="form-group">
                            <input type="text" placeholder="Nombre" required>
                        </div>
                        <div class="form-group">
                            <input type="email" placeholder="Email" required>
                        </div>
                        <div class="form-group">
                            <input type="text" placeholder="Asunto" required>
                        </div>
                        <div class="form-group">
                            <textarea placeholder="Mensaje" rows="5" required></textarea>
                        </div>
                        <button type="submit" class="btn-submit">ENVIAR MENSAJE</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <span class="logo-text">JAVIER MOLES</span>
                    <span class="logo-tag">TECHNO ARTIST · BARCELONA</span>
                </div>
                
                <div class="footer-links">
                    <a href="#">Música</a>
                    <a href="#">Videos</a>
                    <a href="#">Shows</a>
                    <a href="#">Contacto</a>
                    <a href="#">Privacidad</a>
                </div>
                
                <div class="footer-newsletter">
                    <p>Recibe updates de nuevos lanzamientos</p>
                    <div class="newsletter-form">
                        <input type="email" placeholder="tu@email.com">
                        <button type="submit">SUSCRIBIRSE</button>
                    </div>
                </div>
            </div>
            
            <div class="footer-bottom">
                <p>© 2024 Javier Moles. Todos los derechos reservados.</p>
                <p>Diseñado con ❤️ en Barcelona</p>
            </div>
        </div>
    </footer>

    <script src="script.js"></script>
</body>
</html>
