                transition: all 0.3s;
                border-bottom: 1px solid var(--border-light);
                backdrop-filter: blur(10px);
                z-index: 1000;
            }
            
            .nav-links.active {
                transform: translateY(0);
                opacity: 1;
            }
            
            .hero h1 {
                font-size: 40px;
            }
            
            .hero-content {
                text-align: center;
            }
            
            .channel-info {
                justify-content: center;
            }
            
            .quote {
                padding-left: 20px;
                text-align: left;
            }
            
            .section-title {
                font-size: 36px;
            }
            
            .dual-concept {
                grid-template-columns: 1fr;
            }
            
            .content-grid {
                grid-template-columns: 1fr;
            }
            
            .footer-content {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .video-wrapper iframe {
                height: 250px;
            }
        }

        @media (max-width: 480px) {
            .hero h1 {
                font-size: 32px;
            }
            .video-wrapper iframe {
                height: 200px;
            }
            .section-title {
                font-size: 28px;
            }
        }
    </style>
