        /* RESPONSIVE */
        @media (max-width: 1024px) {
            .hero-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            .hero h1 {
                font-size: 56px;
            }
            .about-content {
                grid-template-columns: 1fr;
                gap: 60px;
            }
            .video-wrapper iframe {
                height: 350px;
            }
        }

        @media (max-width: 768px) {
            .mobile-menu-btn {
