/* Estilos generales */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Courier New', monospace;
}

body {
    background-color: #0a0a0a;
    color: #e0e0e0;
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
}

/* Efecto de TV antigua */
.tv-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
        repeating-linear-gradient(0deg, 
            rgba(0, 0, 0, 0.15) 0px, 
            rgba(0, 0, 0, 0.15) 1px, 
            transparent 1px, 
            transparent 2px);
    pointer-events: none;
    z-index: 1000;
    opacity: 0.3;
}

.scanlines {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        to bottom,
        transparent 50%,
        rgba(0, 0, 0, 0.2) 50%
    );
    background-size: 100% 4px;
    pointer-events: none;
    z-index: 1001;
    animation: scanline 10s linear infinite;
}

@keyframes scanline {
    0% {
        background-position: 0 0;
    }
    100% {
        background-position: 0 100%;
    }
}

/* Contenedor principal estilo TV */
.tv-container {
    max-width: 1000px;
    margin: 30px auto;
    background-color: #2a2a2a;
    border: 15px solid #1a1a1a;
    border-radius: 10px;
    box-shadow: 
        0 0 0 5px #333,
        0 0 30px rgba(0, 0, 0, 0.8),
        inset 0 0 20px rgba(0, 0, 0, 0.5);
    position: relative;
    overflow: hidden;
}

.tv-frame {
    position: relative;
    padding: 20px;
}

/* Cabecera */
header {
    text-align: center;
    padding: 20px 0;
    border-bottom: 3px dashed #ccc;
    margin-bottom: 30px;
    position: relative;
}

.tv-knobs {
    display: flex;
    justify-content: space-between;
    position: absolute;
    width: 100%;
    top: 10px;
    padding: 0 20px;
}

.knob {
    width: 20px;
    height: 20px;
    background-color: #555;
    border-radius: 50%;
    box-shadow: inset 0 0 5px #000;
}

h1 {
    font-size: 2.8rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 2px 2px 0 #555;
    margin-top: 20px;
    font-weight: bold;
}

.subtitle {
    font-size: 1.2rem;
    color: #aaa;
    margin-top: 10px;
    letter-spacing: 2px;
}

/* Navegación */
nav {
    display: flex;
    justify-content: center;
    margin: 20px 0;
    flex-wrap: wrap;
}

.nav-button {
    background-color: #444;
    color: #fff;
    border: 2px solid #666;
    padding: 10px 20px;
    margin: 5px 10px;
    cursor: pointer;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
}

.nav-button:hover, .nav-button.active {
    background-color: #666;
    color: #fff;
    border-color: #888;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
}

/* Secciones de contenido */
.content-section {
    display: none;
    padding: 20px;
    animation: fadeIn 1s;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.content-section.active {
    display: block;
}

/* Sección Inicio */
.artist-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 30px;
}

.artist-photo {
    flex: 1;
    min-width: 300px;
    margin-right: 30px;
}

.artist-photo img {
    width: 100%;
    border: 5px solid #555;
    border-radius: 3px;
    filter: grayscale(30%) contrast(1.1);
}

.artist-bio {
    flex: 2;
    min-width: 300px;
}

.artist-bio h2 {
    color: #fff;
    font-size: 1.8rem;
    margin-bottom: 15px;
    border-bottom: 2px solid #666;
    padding-bottom: 5px;
}

.location, .genre {
    display: inline-block;
    background-color: #444;
    padding: 5px 15px;
    margin: 10px 10px 10px 0;
    border-radius: 3px;
    font-size: 0.9rem;
}

/* Sección Galería */
.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.gallery-item {
    border: 3px solid #555;
    overflow: hidden;
    transition: transform 0.3s;
}

.gallery-item:hover {
    transform: scale(1.03);
    border-color: #777;
}

.gallery-item img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
}

/* Sección Short Film */
.film-container {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    margin: 20px 0;
    overflow: hidden;
    border: 5px solid #555;
    background-color: #000;
}

.film-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.film-description {
    margin-top: 20px;
    padding: 15px;
    background-color: #333;
    border-left: 5px solid #666;
}

/* Sección Contacto */
.contact-info {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    margin-top: 20px;
}

.contact-details {
    flex: 1;
    min-width: 300px;
}

.contact-form {
    flex: 1;
    min-width: 300px;
}

.contact-item {
    margin-bottom: 20px;
    padding: 15px;
    background-color: #333;
    border-left: 5px solid #666;
}

.contact-item i {
    margin-right: 10px;
    color: #aaa;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 5px;
    color: #ccc;
}

.form-group input, .form-group textarea {
    width: 100%;
    padding: 10px;
    background-color: #333;
    border: 1px solid #555;
    color: #fff;
    font-family: 'Courier New', monospace;
}

.form-group textarea {
    height: 150px;
    resize: vertical;
}

.submit-btn {
    background-color: #555;
    color: #fff;
    border: none;
    padding: 12px 30px;
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 0.3s;
}

.submit-btn:hover {
    background-color: #777;
}

/* Footer */
footer {
    text-align: center;
    padding: 20px;
    margin-top: 30px;
    border-top: 3px dashed #ccc;
    color: #aaa;
    font-size: 0.9rem;
}

.social-links {
    margin-top: 15px;
}

.social-links a {
    color: #aaa;
    font-size: 1.5rem;
    margin: 0 10px;
    transition: color 0.3s;
}

.social-links a:hover {
    color: #fff;
}

/* Responsividad */
@media (max-width: 768px) {
    .tv-container {
        margin: 10px;
        border-width: 10px;
    }
    
    h1 {
        font-size: 2rem;
    }
    
    .artist-intro {
        flex-direction: column;
    }
    
    .artist-photo {
        margin-right: 0;
        margin-bottom: 20px;
    }
}
